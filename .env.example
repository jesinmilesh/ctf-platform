# ==============================================================================
# XPLOITX // CYBER BATTLEFIELD - PRODUCTION ENVIRONMENT CONFIGURATION
# Implements Section 65 of Master Production Specification
# ==============================================================================

# Core Application Environment
NODE_ENV=production
PORT=4000
SERVER_HOST=xploitxctf.me
PUBLIC_URL=https://xploitxctf.me

# Authentication & Session Security (Section 43 & 65)
JWT_SECRET=xploitx_tactical_jwt_secret_change_in_production_2026
JWT_REFRESH_SECRET=xploitx_tactical_refresh_secret_change_in_production_2026
JWT_EXPIRATION=24h
SESSION_SECRET=xploitx_tactical_session_secret_change_in_production_2026

# CORS & WebSocket Allowed Origins (Section 65)
CORS_ORIGIN=https://xploitxctf.me
WS_ORIGIN=wss://xploitxctf.me

# Competition Flag Syntax Configuration (Section 14 & 24)
FLAG_PREFIX=XploitXβ{
FLAG_SUFFIX=}
FLAG_HMAC_SECRET=xploitx_dynamic_flag_hmac_secret_key_2026

# Database Configuration (MongoDB Atlas or PostgreSQL)
# For MongoDB Atlas:
DB_TYPE=mongodb
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=xploitx_ctf

# For PostgreSQL (Alternative):
# DB_TYPE=postgres
# DATABASE_URL=postgresql://xploitx_admin:tactical_secret_db_pass_2026@postgres:5432/xploitx_db
# POSTGRES_DB=xploitx_db
# POSTGRES_USER=xploitx_admin
# POSTGRES_PASSWORD=tactical_secret_db_pass_2026
# DB_POOL_MIN=2
# DB_POOL_MAX=20

# Redis Telemetry & EventBus Pub/Sub (Section 2 & 65)
REDIS_URL=redis://:tactical_redis_secret@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Dedicated Instance Management Server Configuration (Section 27-40 & 65)
INSTANCE_SERVER_URL=http://instance-server:5000
INSTANCE_SERVER_TOKEN=xploitx_internal_instance_auth_token_secret_2026
INSTANCE_PORT_MIN=41000
INSTANCE_PORT_MAX=41999
INSTANCE_DOMAIN=xploitxctf.me
INSTANCE_DOMAIN_TEMPLATE=inst-{id}.xploitxctf.me
CONTAINER_CPU_LIMIT=0.5
CONTAINER_MEM_LIMIT=256m
DEFAULT_INSTANCE_TTL_MINUTES=30
INSTANCE_STARTUP_TIMEOUT_MS=15000

# File Storage & Object Storage Configuration (Section 13, 46 & 65)
STORAGE_DIR=./challenge-storage
MAX_FILE_SIZE_BYTES=52428800 # 50 MB
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORAGE_BUCKET=xploitx-challenge-files
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# SMTP Mail Notification Configuration (Section 65)
SMTP_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@xploitxctf.me
SMTP_PASS=
SMTP_FROM=XploitX Operations Command <noreply@xploitxctf.me>
