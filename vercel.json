{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/[...all]"
    },
    {
      "source": "/auth/:match*",
      "destination": "/api/[...all]"
    },
    {
      "source": "/assets/:match*",
      "destination": "/frontend/assets/:match*"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/frontend/admin/index.html"
    },
    {
      "source": "/admin/:match*",
      "destination": "/frontend/admin/:match*"
    },
    {
      "source": "/",
      "destination": "/frontend/public/index.html"
    },
    {
      "source": "/((?!api|auth).*)",
      "destination": "/frontend/public/$1"
    }
  ]
}
