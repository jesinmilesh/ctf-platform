{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/[...all]"
    },
    {
      "source": "/auth/:match*",
      "destination": "/api/[...all]"
    },
    {
      "source": "/assets/:match*",
      "destination": "/frontend/assets/:match*"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin/index"
    },
    {
      "source": "/admin/",
      "destination": "/frontend/admin/index"
    },
    {
      "source": "/admin/:match*",
      "destination": "/frontend/admin/:match*"
    },
    {
      "source": "/challenge/:match*",
      "destination": "/frontend/public/challenge"
    },
    {
      "source": "/challenge",
      "destination": "/frontend/public/challenge"
    },
    {
      "source": "/feed",
      "destination": "/frontend/public/activity"
    },
    {
      "source": "/feed.html",
      "destination": "/frontend/public/activity"
    },
    {
      "source": "/intel",
      "destination": "/frontend/public/announcements"
    },
    {
      "source": "/intel.html",
      "destination": "/frontend/public/announcements"
    },
    {
      "source": "/missions",
      "destination": "/frontend/public/challenges"
    },
    {
      "source": "/missions.html",
      "destination": "/frontend/public/challenges"
    },
    {
      "source": "/squad",
      "destination": "/frontend/public/team"
    },
    {
      "source": "/squad.html",
      "destination": "/frontend/public/team"
    },
    {
      "source": "/",
      "destination": "/frontend/public/index"
    },
    {
      "source": "/((?!api|auth).*)",
      "destination": "/frontend/public/$1"
    }
  ]
}
